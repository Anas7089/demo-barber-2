generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  BARBER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  FORFEITED
}

enum ExceptionType {
  AVAILABLE
  UNAVAILABLE
}

enum DepositType {
  NONE
  FIXED
  PERCENTAGE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE
  OTHER
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  MARKETING
  SOFTWARE
  PAYROLL
  TAX
  INSURANCE
  MAINTENANCE
  OTHER
}

model BusinessSettings {
  id                       String      @id @default(cuid())
  businessName             String
  countryCode              String      @db.VarChar(2)
  currency                 String      @default("EUR") @db.VarChar(3)
  timezone                 String
  defaultLocale            String
  supportedLocales         String[]
  vatInclusive             Boolean     @default(true)
  defaultBufferMinutes     Int         @default(5)
  minimumNoticeMinutes     Int         @default(120)
  maxAdvanceBookingDays    Int         @default(60)
  cancellationWindowHours  Int         @default(24)
  depositType              DepositType @default(NONE)
  depositValueCents        Int?
  waitlistEnabled          Boolean     @default(false)
  createdAt                DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime    @updatedAt @db.Timestamptz(3)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  role         UserRole @default(BARBER)
  barberId     String?  @unique
  barber       Barber?  @relation(fields: [barberId], references: [id], onDelete: SetNull)
  failedLoginCount Int    @default(0)
  lockedUntil     DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  manualSalesCreated ManualSale[] @relation("ManualSaleCreatedBy")
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  services  Service[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
}

model Service {
  id              String           @id @default(cuid())
  categoryId      String
  category        ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name            String
  slug            String           @unique
  description     String?
  durationMinutes Int
  priceCents      Int
  costCents       Int              @default(0) // direct consumables/product cost used in margin reporting
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  barbers         BarberService[]
  bookingItems    BookingService[]
  manualSaleItems ManualSaleItem[]
  waitlistEntries WaitlistEntry[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  @@index([categoryId, isActive, sortOrder])
}

model Barber {
  id                    String              @id @default(cuid())
  slug                  String              @unique
  displayName           String
  bio                   String?
  specialty             String?
  instagramUrl          String?
  imageUrl              String?
  isActive              Boolean             @default(true)
  bufferMinutes         Int?
  commissionBps         Int                 @default(0) // 1% = 100 basis points; 10000 = 100%
  services              BarberService[]
  workingHours          BarberWorkingHours[]
  scheduleExceptions    ScheduleException[]
  bookings              Booking[]
  waitlistEntries       WaitlistEntry[]
  manualSales           ManualSale[]
  user                   User?
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)
}

model BarberService {
  barberId  String
  serviceId String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
}

model BarberWorkingHours {
  id        String   @id @default(cuid())
  barberId  String
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // ISO-like convention: 1=Monday ... 7=Sunday
  startTime String   @db.VarChar(5) // HH:mm in shop local timezone
  endTime   String   @db.VarChar(5)
  isWorking Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([barberId, dayOfWeek, startTime, endTime])
  @@index([barberId, dayOfWeek])
}

model ScheduleException {
  id        String        @id @default(cuid())
  barberId  String
  barber    Barber        @relation(fields: [barberId], references: [id], onDelete: Cascade)
  type      ExceptionType
  startAt   DateTime      @db.Timestamptz(3)
  endAt     DateTime      @db.Timestamptz(3)
  note      String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  @@index([barberId, startAt, endAt])
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneE164   String
  locale      String?
  bookings    Booking[]
  waitlist    WaitlistEntry[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([email])
  @@index([phoneE164])
}

model Booking {
  id                    String        @id @default(cuid())
  publicId              String        @unique @default(cuid())
  barberId              String
  barber                Barber        @relation(fields: [barberId], references: [id], onDelete: Restrict)
  customerId            String
  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  startAt               DateTime      @db.Timestamptz(3)
  endAt                 DateTime      @db.Timestamptz(3)
  blockedUntilAt        DateTime      @db.Timestamptz(3) // endAt + effective cleanup buffer
  status                BookingStatus @default(PENDING)
  totalDurationMinutes  Int
  totalPriceCents       Int
  barberCommissionBps   Int           @default(0) // snapshot to keep historical profit stable
  customerNote          String?
  consentGivenAt        DateTime      @db.Timestamptz(3)
  consentPolicyVersion  String
  cancellationTokenHash String?       @unique
  rescheduleTokenHash   String?       @unique
  paymentStatus         PaymentStatus @default(NOT_REQUIRED)
  depositAmountCents    Int?
  stripePaymentIntentId String?       @unique
  items                 BookingService[]
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  @@index([barberId, startAt])
  @@index([customerId, startAt])
  @@index([status, startAt])
}

model BookingService {
  id                    String   @id @default(cuid())
  bookingId             String
  booking               Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId             String
  service               Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceNameSnapshot   String
  durationMinutes       Int
  priceCents            Int
  costCents             Int      @default(0) // snapshot of direct service cost
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  @@index([bookingId, sortOrder])
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  barberId    String?
  barber      Barber?  @relation(fields: [barberId], references: [id], onDelete: SetNull)
  preferredOn DateTime @db.Date
  windowStart String?  @db.VarChar(5)
  windowEnd   String?  @db.VarChar(5)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([preferredOn, active])
  @@index([barberId, preferredOn])
}

model ManualSale {
  id                    String        @id @default(cuid())
  barberId              String
  barber                Barber        @relation(fields: [barberId], references: [id], onDelete: Restrict)
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  occurredAt            DateTime      @db.Timestamptz(3)
  totalRevenueCents     Int
  directCostCents       Int           @default(0)
  barberCommissionBps   Int           @default(0)
  paymentMethod         PaymentMethod @default(CASH)
  note                  String?
  createdByUserId       String
  createdBy             User          @relation("ManualSaleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items                 ManualSaleItem[]
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  @@index([occurredAt])
  @@index([barberId, occurredAt])
  @@index([createdByUserId, occurredAt])
}

model ManualSaleItem {
  id                  String      @id @default(cuid())
  manualSaleId        String
  manualSale          ManualSale  @relation(fields: [manualSaleId], references: [id], onDelete: Cascade)
  serviceId           String?
  service             Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceNameSnapshot String
  priceCents          Int
  costCents           Int         @default(0)
  sortOrder           Int         @default(0)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)

  @@index([manualSaleId, sortOrder])
  @@index([serviceId])
}

model OperatingExpense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amountCents Int
  incurredAt  DateTime        @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([incurredAt])
  @@index([category, incurredAt])
}
